% G1c measurement fixture: the constant-table element family
% (`array_int_element`). A pinned index (`i = 4`) narrows the target `v`
% to the table entry 2 before search; a pinned target (`u = 1`) removes
% the unsupported indices 1, 3 and 4 from the wide `j` before search.
% Without the registered propagator both slots are branched through their
% full ranges. Public route: SAT; witness checker-accepted.
var 4..4: i :: output_var;
var 0..9: v :: output_var;
var 1..4: j :: output_var;
var 1..1: u :: output_var;
constraint array_int_element(i, [4, 5, 7, 2], v);
constraint array_int_element(j, [3, 1, 3, 2], u);
solve satisfy;
