% G1-B fixture: the bool2int channel. The integer target `i` is the raw
% singleton [1], so `propBool2intSlot` (`Proofs/Fam/Bool.lean`) pins the
% source Boolean `b` to true from the target without a Boolean decision;
% the second wide target `j` (0..5) then has its non-{0,1} values removed
% through the pinned channel. Public route: SAT with b = true, i = 1 and
% j = 1; witness checker-accepted.
var bool: b :: output_var;
var 1..1: i :: output_var;
var 0..5: j :: output_var;
constraint bool2int(b, i);
constraint bool2int(b, j);
solve satisfy;
