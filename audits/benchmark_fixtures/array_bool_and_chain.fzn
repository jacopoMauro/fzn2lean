% G1e measurement fixture: the array-Boolean conjunction family
% (`array_bool_and`). The two bool2int channels pin a and b true, so the
% all-inputs-pinned round of `array_bool_and([a, b], c)` pins c true
% without a decision; c true then drives the pinned-target round of
% `array_bool_and([f, g], c)` and `array_bool_and([h], c)` (f, g, h
% pinned true); the pinned-false input d (from its 0/0 channel) forces
% e false through the pinned-false-input round. Public route: SAT;
% witness checker-accepted.
var bool: a :: output_var;
var bool: b :: output_var;
var bool: c :: output_var;
var bool: f :: output_var;
var bool: g :: output_var;
var bool: d :: output_var;
var bool: e :: output_var;
var bool: h :: output_var;
var 1..1: ia :: output_var;
var 1..1: ib :: output_var;
var 0..0: id :: output_var;
constraint bool2int(a, ia);
constraint bool2int(b, ib);
constraint bool2int(d, id);
constraint array_bool_and([a, b], c);
constraint array_bool_and([f, g], c);
constraint array_bool_and([d], e);
constraint array_bool_and([h], c);
solve satisfy;
