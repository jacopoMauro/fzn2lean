var 1..3: x00 :: output_var;
var 1..3: x01 :: output_var;
var 1..3: x02 :: output_var;
var 1..3: x10 :: output_var;
var 1..3: x11 :: output_var;
var 1..3: x12 :: output_var;
var 1..3: x20 :: output_var;
var 1..3: x21 :: output_var;
var 1..3: x22 :: output_var;
constraint all_different([x00,x01,x02]);
constraint all_different([x10,x11,x12]);
constraint all_different([x20,x21,x22]);
constraint all_different([x00,x10,x20]);
constraint all_different([x01,x11,x21]);
constraint all_different([x02,x12,x22]);
solve satisfy;
