var 1..4: x00 :: output_var;
var 1..4: x01 :: output_var;
var 1..4: x02 :: output_var;
var 1..4: x03 :: output_var;
var 1..4: x10 :: output_var;
var 1..4: x11 :: output_var;
var 1..4: x12 :: output_var;
var 1..4: x13 :: output_var;
var 1..4: x20 :: output_var;
var 1..4: x21 :: output_var;
var 1..4: x22 :: output_var;
var 1..4: x23 :: output_var;
var 1..4: x30 :: output_var;
var 1..4: x31 :: output_var;
var 1..4: x32 :: output_var;
var 1..4: x33 :: output_var;
constraint all_different([x00,x01,x02,x03]);
constraint all_different([x10,x11,x12,x13]);
constraint all_different([x20,x21,x22,x23]);
constraint all_different([x30,x31,x32,x33]);
constraint all_different([x00,x10,x20,x30]);
constraint all_different([x01,x11,x21,x31]);
constraint all_different([x02,x12,x22,x32]);
constraint all_different([x03,x13,x23,x33]);
solve satisfy;
