var 0..8: x0 :: output_var;
var 0..8: x1 :: output_var;
var 0..8: x2 :: output_var;
var 0..8: x3 :: output_var;
var 0..8: x4 :: output_var;
var 0..8: x5 :: output_var;
var 0..8: x6 :: output_var;
var 0..8: x7 :: output_var;
constraint int_lin_eq([1,1,1,1,1,1,1,1],[x0,x1,x2,x3,x4,x5,x6,x7],8);
constraint int_le(x0,1);
solve satisfy;
