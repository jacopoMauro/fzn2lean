% G1 section 3.3 measurement fixture: the variable-table element family
% (`array_var_int_element`). The table slots split into `a = {3,4}`,
% `b = {0,1}`, `c = {3,4}` while the target `v = {0,1}`: at the root the
% unpinned index round removes `i = 1` and `i = 3` by hull separation,
% pinning `i = 2`, and the pinned-index round then channelizes `b` and `v`.
% Without the registered propagator both `i` and `v` are branched through
% their full ranges. Public route: SAT; witness checker-accepted.
var 3..4: a :: output_var;
var 0..1: b :: output_var;
var 3..4: c :: output_var;
array [1..3] of var int: t = [a, b, c];
var 1..3: i :: output_var;
var 0..1: v :: output_var;
constraint array_var_int_element(i, t, v);
solve satisfy;
