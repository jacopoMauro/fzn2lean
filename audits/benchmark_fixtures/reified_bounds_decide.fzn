% G1 fixture: the reif slot is unpinned but the operand extrema separate
% (x = 0, y in 1..3), so the bounds-decide-r arm `propLeReifB`
% (`Proofs/Fam/Reif.lean`) pins b = true from the bounds without a
% decision on b. Reachable on the public route once the strengthened run
% function `propLeReifSlotB` is registered in place of `propLeReifSlot`
% (coordinator-owned wiring). Harness run today: SAT, checker OK, no
% semantic invariant observations.
var 0..0: x :: output_var;
var 1..3: y :: output_var;
var bool: b :: output_var;
constraint int_le_reif(x, y, b);
solve satisfy;
