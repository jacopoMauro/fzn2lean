/-
File: LeanFzn/Integration/Optimization/Budget.lean

Purpose (PLAN F5): the BUDGETED, RESTARTED and PORTFOLIO seeded optimizer.

* `RestartKind` (`none | luby | geom`) selects a budget schedule.  `lubyList`
  is the true Luby sequence `1,1,2,1,1,2,4,…` generated by the block
  recurrence `B(k+1) = B(k) ++ B(k) ++ [2^(k+1)]`; `geomList base count` is
  `base, 2*base, 4*base, …`.  `probeBudgets` maps a schedule to the list of
  fuel budgets handed to the budgeted entry.
* `lcgSeedSolverBudget o budgets` is a `SeedCertSolver` whose seeded solve
  first runs the budgeted seeded prefixes (each from the SAME initial seed,
  first terminal result wins) and, when every probe is exhausted, falls back
  to the COMPLETE certified seeded route `lcgSolveDb`.  Hence it is the
  existing certified solver with an observably shorter first attempt: every
  `SeedCertSolver` field is proved, and a terminal probe returns the input
  seed (no seed is invented from a prefix).
* `probeLoop` is the restart/portfolio driver: one budgeted b&b round per
  segment, carrying the incumbent bound and the learned database; the
  final complete `optLoopSeed` at the last configuration is the only part
  that may claim optimality/UNSAT.  `portfolioRun_inv` proves soundness,
  strict improvement, final-bound and final-claim facts.

Claim discipline: an exhausted probe makes no claim; only the final complete
route sets `PortfolioRun.complete`. These historical budget/portfolio adapters
are not part of the public Core-only CLI.

DAG: LcgSeedBudget + OptimizeSeed + LcgSeedConfig -> this file -> CLI adapter.
NO `sorry`, NO custom axiom.
-/
import LeanFzn.Legacy.Integration.Optimization.KernelSeedBudget
import LeanFzn.Legacy.Integration.Optimization.KernelSeedConfig
import LeanFzn.Legacy.Integration.Optimization.Seed

namespace LeanFzn.Integration
open LeanFzn.Semantics LeanFzn.Semantics.Globals LeanFzn.Semantics.Evaluation
open LeanFzn.Compiler LeanFzn.Solver.Core
open LeanFzn.Solver.Propagation LeanFzn.Solver.Propagation.DomainFiltering
open LeanFzn.Solver.UIP

/-! ## §1 Restart schedules: the true Luby sequence and the geometric list -/

/-- Driver-level restart schedule.  This is deliberately separate from the
CLI `--restart` enum: the coordinator maps the parsed `RestartStrategy` to
this kind, and the kernel-level configuration stays `SearchConfig`. -/
inductive RestartKind where
  /-- no restarts: the complete certified route only -/
  | none
  /-- Luby restart schedule `1,1,2,1,1,2,4,…` -/
  | luby
  /-- geometric schedule `1,2,4,…` -/
  | geom
  deriving Repr, DecidableEq, Inhabited

/-- Map the frozen `--restart` strategy surface to the F5 schedule kind. -/
def RestartKind.ofStrategy : RestartStrategy → RestartKind
  | .none => .none
  | .luby => .luby
  | .geom => .geom

/-- The frozen number of budget probes in a `--restart` schedule.  The F5
flag surface has no count flag; `--restart-base` only scales the slices. -/
def restartProbeCount : Nat := 8

/-- The Luby block recurrence: block `k+1` is two copies of block `k`
followed by `2^(k+1)`.  `lubyBlocks 0 = [1]`, so the concatenation of all
blocks is `1,1,2,1,1,2,4,…` and every block is a prefix of the Luby
sequence.  (Standard Luby's sequence, not the off-by-one variant.) -/
def lubyBlocks : Nat → List Nat
  | 0 => [1]
  | k + 1 => lubyBlocks k ++ lubyBlocks k ++ [2 ^ (k + 1)]

/-- Every block has length `2^(k+1) - 1`. -/
theorem lubyBlocks_length (k : Nat) : (lubyBlocks k).length = 2 ^ (k + 1) - 1 := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [lubyBlocks, List.length_append, List.length_append, ih]
      simp only [List.length_singleton]
      rw [Nat.pow_succ]
      have hpos : 0 < 2 ^ (k + 1) := Nat.two_pow_pos _
      omega

/-- Fuel-bounded halving count: `lubyDepthAux fuel n` is the number of
halvings of `n` (at most `fuel` of them).  The explicit fuel keeps the
definition structurally recursive, so concrete Luby prefixes compute by
kernel reduction (`rfl`/`decide`), not by an opaque well-founded fixpoint. -/
def lubyDepthAux : Nat → Nat → Nat
  | 0, _ => 0
  | fuel + 1, n =>
      match n with
      | 0 => 0
      | m + 1 => lubyDepthAux fuel ((m + 1) / 2) + 1

/-- The depth of the Luby block prefix long enough for `n` entries. -/
def lubyDepth (n : Nat) : Nat :=
  lubyDepthAux n n

theorem lubyDepthAux_bound :
    ∀ fuel n, n ≤ fuel → n + 1 ≤ 2 ^ (lubyDepthAux fuel n + 1) := by
  intro fuel
  induction fuel with
  | zero =>
      intro n hn
      have : n = 0 := by omega
      subst this
      simp [lubyDepthAux]
  | succ fuel ih =>
      intro n hn
      cases n with
      | zero => simp [lubyDepthAux]
      | succ m =>
          rw [lubyDepthAux]
          have hle : (m + 1) / 2 ≤ fuel := by omega
          have hIH := ih ((m + 1) / 2) hle
          rw [Nat.pow_succ]
          omega

/-- The selected block has at least `n` entries. -/
theorem lubyDepth_bound (n : Nat) : n + 1 ≤ 2 ^ (lubyDepth n + 1) :=
  lubyDepthAux_bound n n (Nat.le_refl n)

/-- The first `count` terms of the Luby sequence, scaled by `base`.
`lubyList base 7 = [base, base, 2*base, base, base, 2*base, 4*base]`. -/
def lubyList (base count : Nat) : List Nat :=
  ((lubyBlocks (lubyDepth count)).take count).map (fun x => base * x)

/-- The Luby prefix has exactly `count` entries. -/
theorem lubyList_length (base count : Nat) : (lubyList base count).length = count := by
  unfold lubyList
  rw [List.length_map, List.length_take, lubyBlocks_length]
  have hb := lubyDepth_bound count
  omega

/-- The geometric budget list `base, 2*base, 4*base, …` (exactly `count`
entries). -/
def geomList (base count : Nat) : List Nat :=
  (List.range count).map (fun i => base * 2 ^ i)

/-- The geometric list has exactly `count` entries. -/
@[simp] theorem geomList_length (base count : Nat) : (geomList base count).length = count := by
  simp [geomList]

/-- The budget slice of a restart schedule.  `none` schedules no probe at
all: the seeded solve goes straight to the complete certified route.  `luby`
and `geom` schedule `count` independent prefixes with the true sequence. -/
def probeBudgets : RestartKind → Nat → Nat → List Nat
  | .none, _, _ => []
  | .luby, base, count => lubyList base count
  | .geom, base, count => geomList base count

@[simp] theorem probeBudgets_none (base count : Nat) :
    probeBudgets .none base count = [] := rfl

@[simp] theorem probeBudgets_luby (base count : Nat) :
    probeBudgets .luby base count = lubyList base count := rfl

@[simp] theorem probeBudgets_geom (base count : Nat) :
    probeBudgets .geom base count = geomList base count := rfl

/-- The schedule has exactly `count` probes, except `none` which has none. -/
theorem probeBudgets_length (kind : RestartKind) (base count : Nat) :
    (probeBudgets kind base count).length =
      match kind with | .none => 0 | .luby => count | .geom => count := by
  cases kind <;> simp [probeBudgets, lubyList_length]

/-- Concrete kernel check: the schedule really is the Luby sequence
`1,1,2,1,1,2,4`, computed by reduction. -/
example : lubyList 1 7 = [1, 1, 2, 1, 1, 2, 4] := rfl

/-- Concrete kernel check: the geometric list is `1,2,4,8`. -/
example : geomList 1 4 = [1, 2, 4, 8] := rfl

/-! ## §2 The budgeted seeded solver instance -/

/-- The outcome of the ordered budget probes.  `exhausted` means every budget
was exhausted; a `sat`/`unsat` is a terminal result of one certified prefix. -/
inductive ProbeOut (leaf : Assignment → Bool) where
  /-- every probe was exhausted: the caller must run the complete route -/
  | exhausted
  /-- a probe reached a satisfying assignment -/
  | sat (w : Assignment)
  /-- a probe closed the root box -/
  | unsat

/-- Run the seeded budget prefixes in order, each from the SAME initial
seeded configuration (independent probes, first terminal result wins).  Every
terminal result is a terminal result of the complete seeded run, so
`budgetProbe_sat`/`_unsat` transfer the problem-level claims directly. -/
def budgetProbe (p : CompiledProblem DomConstraint) (s : SeedDb p.domains)
    (hg : lcgRouteGateMixed p = true) (prio : List Nat) (actBump : Bool) :
    List Nat → ProbeOut (lcgLeafSeed p s)
  | [] => .exhausted
  | b :: bs =>
      match lcgSeedRunBudget p s hg prio actBump b with
      | .exhausted => budgetProbe p s hg prio actBump bs
      | .sat w => .sat w
      | .unsat => .unsat

@[simp] theorem budgetProbe_nil (p : CompiledProblem DomConstraint)
    (s : SeedDb p.domains) (hg : lcgRouteGateMixed p = true)
    (prio : List Nat) (actBump : Bool) :
    budgetProbe p s hg prio actBump [] = .exhausted := rfl

/-- The one-step equation of `budgetProbe`, definitional. -/
theorem budgetProbe_cons (p : CompiledProblem DomConstraint)
    (s : SeedDb p.domains) (hg : lcgRouteGateMixed p = true)
    (prio : List Nat) (actBump : Bool) (b : Nat) (bs : List Nat) :
    budgetProbe p s hg prio actBump (b :: bs) =
      (match lcgSeedRunBudget p s hg prio actBump b with
       | .exhausted => budgetProbe p s hg prio actBump bs
       | .sat w => .sat w
       | .unsat => .unsat) := rfl

/-- **SAT SOUNDNESS OF THE PROBE SCHEDULE**: a probe that terminates with
`.sat w` has the complete seeded run's SAT witness (same kernel, same seed). -/
theorem budgetProbe_sat (p : CompiledProblem DomConstraint) (s : SeedDb p.domains)
    (hg : lcgRouteGateMixed p = true) (prio : List Nat) (actBump : Bool)
    {budgets : List Nat} {w : Assignment}
    (h : budgetProbe p s hg prio actBump budgets = .sat w) :
    w ∈ allAssigns p.domains ∧ accepts p w = true := by
  induction budgets with
  | nil => simp [budgetProbe] at h
  | cons b bs ih =>
      rw [budgetProbe_cons] at h
      cases hb : lcgSeedRunBudget p s hg prio actBump b with
      | exhausted =>
          simp only [hb] at h
          exact ih h
      | sat w' =>
          rw [hb] at h
          cases h
          exact lcgSeedRunBudget_sat p s hg prio actBump hb
      | unsat =>
          rw [hb] at h
          cases h

/-- **UNSAT COMPLETENESS OF THE PROBE SCHEDULE**: a probe that terminates
with `.unsat` excludes every accepted assignment (given the seed is entailed
at the problem leaf). -/
theorem budgetProbe_unsat (p : CompiledProblem DomConstraint) (s : SeedDb p.domains)
    (hg : lcgRouteGateMixed p = true) (prio : List Nat) (actBump : Bool)
    {budgets : List Nat}
    (h : budgetProbe p s hg prio actBump budgets = .unsat)
    (hseed : LearnedEntailed (lcgLeaf p) s.clauses) :
    ∀ b ∈ allAssigns p.domains, accepts p b = false := by
  induction budgets with
  | nil => simp [budgetProbe] at h
  | cons b bs ih =>
      rw [budgetProbe_cons] at h
      cases hb : lcgSeedRunBudget p s hg prio actBump b with
      | exhausted =>
          simp only [hb] at h
          exact ih h
      | sat w' =>
          rw [hb] at h
          cases h
      | unsat =>
          rw [hb] at h
          cases h
          exact lcgSeedRunBudget_unsat p s hg prio actBump hb hseed

/-- **THE BUDGETED SEEDED SOLVER**: the configured certified seeded solver
with an ordered probe schedule in front of it.  A terminal probe returns the
INPUT seed (a prefix does not expose a new database), an exhausted schedule
falls back to the complete certified route `lcgSolveDb`.  Every
`SeedCertSolver` obligation is proved from the budgeted-run soundness. -/
def lcgSeedSolverBudget (o : SearchConfig) (budgets : List Nat) : SeedCertSolver where
  solve := lcgVerdict (o := o)
  gate := fun p => gateOk (lcgProblem p)
  leaf := lcgLeaf
  solveDb := fun orig p hd s =>
    if hg : lcgRouteGateMixed p = true then
      match budgetProbe p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
          (lcgConfigActBump o) budgets with
      | .sat a => (.sat a, s)
      | .unsat => (.unsat, s)
      | .exhausted =>
          lcgSolveDb orig p hd s (prio := lcgConfigPrio o p) (actBump := lcgConfigActBump o)
    else
      lcgSolveDb orig p hd s (prio := lcgConfigPrio o p) (actBump := lcgConfigActBump o)
  sat_sound := fun _ _ h => lcgVerdict_sat h
  unsat_complete := fun _ h => lcgVerdict_unsat h
  gate_add := fun _ _ => rfl
  total := by
    intro p hg hfail
    unfold lcgVerdict at hfail
    split at hfail
    · cases hfail
    · cases hfail
    · rename_i hs
      exact solveSearchConfig_verdict p o hs
  sat_sound_db := by
    intro orig p hd s a s' h
    by_cases hg : lcgRouteGateMixed p = true
    · simp only [dif_pos hg] at h
      cases hp : budgetProbe p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
          (lcgConfigActBump o) budgets with
      | sat w =>
          simp only [hp, Prod.mk.injEq] at h
          obtain ⟨hva, -⟩ := h
          cases hva
          exact budgetProbe_sat p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
            (lcgConfigActBump o) hp
      | unsat =>
          simp only [hp] at h
          cases h
      | exhausted =>
          simp only [hp] at h
          exact lcgSolveDb_sat_sound (prio := lcgConfigPrio o p)
            (actBump := lcgConfigActBump o) h
    · simp only [dif_neg hg] at h
      exact lcgSolveDb_sat_sound (prio := lcgConfigPrio o p)
        (actBump := lcgConfigActBump o) h
  unsat_complete_db := by
    intro orig p hd s s' h hseed
    by_cases hg : lcgRouteGateMixed p = true
    · simp only [dif_pos hg] at h
      cases hp : budgetProbe p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
          (lcgConfigActBump o) budgets with
      | sat w =>
          simp only [hp] at h
          cases h
      | unsat =>
          exact budgetProbe_unsat p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
            (lcgConfigActBump o) hp hseed
      | exhausted =>
          simp only [hp] at h
          exact lcgSolveDb_unsat_complete (prio := lcgConfigPrio o p)
            (actBump := lcgConfigActBump o) h hseed
    · simp only [dif_neg hg] at h
      exact lcgSolveDb_unsat_complete (prio := lcgConfigPrio o p)
        (actBump := lcgConfigActBump o) h hseed
  db_entailed := by
    intro orig p hd s hseed
    by_cases hg : lcgRouteGateMixed p = true
    · simp only [dif_pos hg]
      cases hp : budgetProbe p (SeedDb.cast hd.symm s) hg (lcgConfigPrio o p)
          (lcgConfigActBump o) budgets with
      | sat w =>
          exact hseed
      | unsat =>
          exact hseed
      | exhausted =>
          exact lcgSolveDb_db_entailed (prio := lcgConfigPrio o p)
            (actBump := lcgConfigActBump o) hseed
    · simp only [dif_neg hg]
      exact lcgSolveDb_db_entailed (prio := lcgConfigPrio o p)
        (actBump := lcgConfigActBump o) hseed
  total_db := by
    intro orig p hd s hg
    by_cases hroute : lcgRouteGateMixed p = true
    · simp only [dif_pos hroute]
      cases hp : budgetProbe p (SeedDb.cast hd.symm s) hroute (lcgConfigPrio o p)
          (lcgConfigActBump o) budgets with
      | sat w =>
          intro hf
          cases hf
      | unsat =>
          intro hf
          cases hf
      | exhausted =>
          exact lcgSolveDb_total (prio := lcgConfigPrio o p)
            (actBump := lcgConfigActBump o) hg
    · simp only [dif_neg hroute]
      exact lcgSolveDb_total (prio := lcgConfigPrio o p)
        (actBump := lcgConfigActBump o) hg
  leaf_add := fun p c a ha => lcgLeaf_addConstraint p c a ha
  leaf_bound := fun _ _ _ _ hwb a ha => lcgLeaf_improveBound hwb a ha

/-- The budgeted solver uses the configured gate, definitionally. -/
@[simp] theorem lcgSeedSolverBudget_gate (o : SearchConfig) (budgets : List Nat)
    (p : CompiledProblem DomConstraint) :
    (lcgSeedSolverBudget o budgets).gate p = gateOk (lcgProblem p) := rfl

/-- The budgeted solver uses the mixed problem leaf, definitionally. -/
@[simp] theorem lcgSeedSolverBudget_leaf (o : SearchConfig) (budgets : List Nat)
    (p : CompiledProblem DomConstraint) :
    (lcgSeedSolverBudget o budgets).leaf p = lcgLeaf p := rfl

structure BudgetSegment where
  config : SearchConfig
  budgets : List Nat
  deriving Repr

/-- The restart schedule as budgeted segments: one segment per scheduled
budget, all under the same configuration.  The portfolio loop then runs the
budgets in order, carrying the incumbent bound and the seed forward.  `none`
schedules no probe, so the run is exactly the final complete route. -/
def restartSegments (kind : RestartKind) (base count : Nat) (o : SearchConfig) :
    List BudgetSegment :=
  (probeBudgets kind base count).map (fun b => ⟨o, [b]⟩)

@[simp] theorem restartSegments_none (base count : Nat) (o : SearchConfig) :
    restartSegments .none base count o = [] := rfl

/-- A restart schedule has one probe segment per budget (none has none). -/
theorem restartSegments_length (kind : RestartKind) (base count : Nat)
    (o : SearchConfig) :
    (restartSegments kind base count o).length =
      match kind with | .none => 0 | .luby => count | .geom => count := by
  cases kind <;> simp [restartSegments, probeBudgets, lubyList_length]

structure ProbeRun (p0 : CompiledProblem DomConstraint) where
  sols : List (List Value × Int)
  bo : Option Int
  seed : SeedDb p0.domains
  /-- the number of budgeted probe segments actually attempted (the loop
  stops early when a probe returns UNSAT or FAIL) -/
  probes : Nat

def probeStep (p0 : CompiledProblem DomConstraint)
    (next : Option Int → SeedDb p0.domains → ProbeRun p0) (spec : ObjectiveSpec)
    (bo : Option Int) (s : SeedDb p0.domains)
    (d : CertVerdict × SeedDb p0.domains) : ProbeRun p0 :=
  match d with
  | (.unsat, s') => ⟨[], bo, s', 1⟩
  | (.fail, _) => ⟨[], bo, s, 1⟩
  | (.sat a, s') =>
      match a[spec.slot]? with
      | some (.int v) =>
          let rr := next (some v) (s'.withPrev (some a))
          ⟨(a, v) :: rr.sols, rr.bo, rr.seed, 1 + rr.probes⟩
      | _ => ⟨[], bo, s, 1⟩

def probeLoop (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec) :
    List BudgetSegment → Option Int → SeedDb p0.domains → ProbeRun p0
  | [], bo, s => ⟨[], bo, s, 0⟩
  | seg :: rest, bo, s =>
      probeStep p0 (fun bo' s' => probeLoop p0 spec rest bo' s') spec bo s
        ((lcgSeedSolverBudget seg.config seg.budgets).solveDb p0.domains
          (curP p0 spec bo) (curP_domains p0 spec bo) s)

private theorem probeLoop_unsat_eq {p0 : CompiledProblem DomConstraint}
    {spec : ObjectiveSpec} {c : SearchConfig} {bs : List Nat}
    {rest : List BudgetSegment} {bo : Option Int} {s s' : SeedDb p0.domains}
    (hc : (lcgSeedSolverBudget c bs).solveDb p0.domains (curP p0 spec bo)
      (curP_domains p0 spec bo) s = (.unsat, s')) :
    probeLoop p0 spec (⟨c, bs⟩ :: rest) bo s = ⟨[], bo, s', 1⟩ := by
  rw [probeLoop]
  rw [hc]
  rfl

private theorem probeLoop_fail_eq {p0 : CompiledProblem DomConstraint}
    {spec : ObjectiveSpec} {c : SearchConfig} {bs : List Nat}
    {rest : List BudgetSegment} {bo : Option Int} {s s' : SeedDb p0.domains}
    (hc : (lcgSeedSolverBudget c bs).solveDb p0.domains (curP p0 spec bo)
      (curP_domains p0 spec bo) s = (.fail, s')) :
    probeLoop p0 spec (⟨c, bs⟩ :: rest) bo s = ⟨[], bo, s, 1⟩ := by
  rw [probeLoop]
  rw [hc]
  rfl

private theorem probeLoop_sat_int_eq {p0 : CompiledProblem DomConstraint}
    {spec : ObjectiveSpec} {c : SearchConfig} {bs : List Nat}
    {rest : List BudgetSegment} {bo : Option Int} {s s' : SeedDb p0.domains}
    {a : List Value} {v : Int}
    (hc : (lcgSeedSolverBudget c bs).solveDb p0.domains (curP p0 spec bo)
      (curP_domains p0 spec bo) s = (.sat a, s'))
    (hv : a[spec.slot]? = some (.int v)) :
    probeLoop p0 spec (⟨c, bs⟩ :: rest) bo s =
      (let rr := probeLoop p0 spec rest (some v) (s'.withPrev (some a))
       ⟨(a, v) :: rr.sols, rr.bo, rr.seed, 1 + rr.probes⟩) := by
  rw [probeLoop]
  rw [hc]
  simp only [probeStep]
  rw [hv]

private theorem probeLoop_sat_other_eq {p0 : CompiledProblem DomConstraint}
    {spec : ObjectiveSpec} {c : SearchConfig} {bs : List Nat}
    {rest : List BudgetSegment} {bo : Option Int} {s s' : SeedDb p0.domains}
    {a : List Value}
    (hc : (lcgSeedSolverBudget c bs).solveDb p0.domains (curP p0 spec bo)
      (curP_domains p0 spec bo) s = (.sat a, s'))
    (hn : ∀ v : Int, a[spec.slot]? ≠ some (.int v)) :
    probeLoop p0 spec (⟨c, bs⟩ :: rest) bo s = ⟨[], bo, s, 1⟩ := by
  rw [probeLoop]
  rw [hc]
  rw [probeStep]
  cases hv : a[spec.slot]? with
  | none => rfl
  | some w =>
      cases w with
      | int v => exact absurd hv (hn v)
      | bool b => rfl
      | setOfInt st => rfl
      | array arr => rfl

structure ProbeInv (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec)
    (bo : Option Int) (s : SeedDb p0.domains) (pr : ProbeRun p0) : Prop where
  sound : ∀ t ∈ pr.sols, t.1 ∈ allAssigns p0.domains ∧
    accepts (curP p0 spec bo) t.1 = true ∧ t.1[spec.slot]? = some (.int t.2)
  pairwise : pr.sols.Pairwise (fun t u => betterB spec.dir u.2 t.2 = true)
  last : ∀ t, pr.sols.getLast? = some t → pr.bo = some t.2
  nil : pr.sols = [] → pr.bo = bo
  seed_ent : LearnedEntailed (lcgLeaf (curP p0 spec pr.bo)) pr.seed.clauses


/-- Acceptance under a stronger bound implies acceptance under a weaker one,
provided every strictly better bound value has a strictly better counterpart
in the weaker bound.  This is the transfer used when the restart/portfolio
loop moves the incumbent forward. -/
theorem accepts_curP_mono {p0 : CompiledProblem DomConstraint} {spec : ObjectiveSpec}
    {b1 b2 : Option Int}
    (hle : ∀ b, b2 = some b → ∃ w, b1 = some w ∧ betterB spec.dir w b = true) :
    ∀ a, accepts (curP p0 spec b1) a = true → accepts (curP p0 spec b2) a = true := by
  intro a hacc
  cases b2 with
  | none => exact (accepts_curP hacc).1
  | some b =>
      obtain ⟨w, hb1, hwb⟩ := hle b rfl
      have hacc' : accepts (p0.addConstraint (spec.improveBound w)) a = true := by
        simpa [curP, hb1] using hacc
      obtain ⟨haccP, hsatisfied⟩ := accepts_add.mp hacc'
      change accepts (p0.addConstraint (spec.improveBound b)) a = true
      rw [accepts_add]
      exact ⟨haccP, improveBound_satisfiedB_mono hwb a hsatisfied⟩

/-- If a pairwise-improving list ends at `last`, a value that beats `last`
beats every element of the list. -/
theorem betterB_of_pairwise_last {dir : OptDir} :
    ∀ (l : List (List Value × Int)) (x : Int) (last : List Value × Int),
      l.Pairwise (fun t u => betterB dir u.2 t.2 = true) →
      l.getLast? = some last →
      betterB dir x last.2 = true →
      ∀ t ∈ l, betterB dir x t.2 = true := by
  intro l
  induction l with
  | nil =>
      intro x last hp hl hx
      cases hl
  | cons t rest ih =>
      intro x last hp hl hx y hy
      cases rest with
      | nil =>
          rcases List.mem_cons.mp hy with hyt | hy
          · rw [hyt]
            have hlast : t = last := by simpa using hl
            simpa [hlast] using hx
          · simp at hy
      | cons u rest' =>
          rcases List.mem_cons.mp hy with hyt | hy
          · rw [hyt]
            have hp' : (u :: rest').Pairwise
                (fun t u => betterB dir u.2 t.2 = true) :=
              (List.pairwise_cons.mp hp).2
            have hl' : (u :: rest').getLast? = some last := by
              simpa [List.getLast?_cons_cons] using hl
            have hu : betterB dir x u.2 = true :=
              ih x last hp' hl' hx u (by simp)
            exact betterB_trans hu ((List.pairwise_cons.mp hp).1 u (by simp))
          · exact ih x last (List.pairwise_cons.mp hp).2
              (by simpa [List.getLast?_cons_cons] using hl) hx y hy

/-- **THE PROBE LOOP INVARIANT**: the accumulated probe solutions are sound,
strictly improving and accepted at the round's input bound; a nonempty list
records its last value as the current bound; and the carried seed is entailed
at the current bounded problem. -/
theorem probeLoop_inv (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec) :
    ∀ (segs : List BudgetSegment) (bo : Option Int) (s : SeedDb p0.domains),
      LearnedEntailed (lcgLeaf (curP p0 spec bo)) s.clauses →
      ProbeInv p0 spec bo s (probeLoop p0 spec segs bo s) := by
  intro segs
  induction segs with
  | nil =>
      intro bo s hseed
      change ProbeInv p0 spec bo s ⟨[], bo, s, 0⟩
      exact ⟨by intro t ht; simp at ht, by simp, by intro t ht; simp at ht,
        fun _ => rfl, hseed⟩
  | cons seg rest ih =>
      intro bo s hseed
      obtain ⟨c, bs⟩ := seg
      cases hc : (lcgSeedSolverBudget c bs).solveDb p0.domains (curP p0 spec bo)
          (curP_domains p0 spec bo) s with
      | mk v s' =>
        cases v with
        | unsat =>
            rw [probeLoop_unsat_eq hc]
            have hdb := (lcgSeedSolverBudget c bs).db_entailed p0.domains
              (curP p0 spec bo) (curP_domains p0 spec bo) s hseed
            rw [hc] at hdb
            exact ⟨by intro t ht; simp at ht, by simp, by intro t ht; simp at ht,
              fun _ => rfl, hdb⟩
        | fail =>
            rw [probeLoop_fail_eq hc]
            exact ⟨by intro t ht; simp at ht, by simp, by intro t ht; simp at ht,
              fun _ => rfl, hseed⟩
        | sat a =>
            cases hv : a[spec.slot]? with
            | none =>
                rw [probeLoop_sat_other_eq hc
                  (by intro v hv'; rw [hv] at hv'; cases hv')]
                exact ⟨by intro t ht; simp at ht, by simp,
                  by intro t ht; simp at ht, fun _ => rfl, hseed⟩
            | some w =>
                cases w with
                | int v =>
                    rw [probeLoop_sat_int_eq hc hv]
                    have hsat := (lcgSeedSolverBudget c bs).sat_sound_db p0.domains
                      (curP p0 spec bo) (curP_domains p0 spec bo) s a s' hc
                    rw [curP_domains] at hsat
                    have hdb := (lcgSeedSolverBudget c bs).db_entailed p0.domains
                      (curP p0 spec bo) (curP_domains p0 spec bo) s hseed
                    rw [hc] at hdb
                    have hseed' : LearnedEntailed (lcgLeaf (curP p0 spec (some v)))
                        (s'.withPrev (some a)).clauses := by
                      cases bo with
                      | none =>
                          exact learnedEntailed_mono
                            (leaf₁ := lcgLeaf p0)
                            (leaf₂ := lcgLeaf (curP p0 spec (some v)))
                            (fun x hx =>
                              lcgLeaf_addConstraint p0 (spec.improveBound v) x hx) hdb
                      | some b =>
                          have hbv : betterB spec.dir v b = true :=
                            (accepts_curP hsat.2).2 b v rfl hv
                          exact learnedEntailed_mono
                            (leaf₁ := lcgLeaf (curP p0 spec (some b)))
                            (leaf₂ := lcgLeaf (curP p0 spec (some v)))
                            (fun x hx => lcgLeaf_improveBound hbv x hx) hdb
                    have hIH := ih (some v) (s'.withPrev (some a)) hseed'
                    refine ⟨?_, ?_, ?_, ?_, hIH.seed_ent⟩
                    · intro t ht
                      rcases List.mem_cons.mp ht with rfl | ht
                      · exact ⟨hsat.1, hsat.2, hv⟩
                      · obtain ⟨hmem, hacc, hint⟩ := hIH.sound t ht
                        refine ⟨hmem, ?_, hint⟩
                        apply accepts_curP_mono (b1 := some v) (b2 := bo)
                        · intro b hb
                          refine ⟨v, rfl, ?_⟩
                          cases hb
                          exact (accepts_curP hsat.2).2 b v rfl hv
                        · exact hacc
                    · refine List.pairwise_cons.mpr ⟨fun t ht => ?_, hIH.pairwise⟩
                      obtain ⟨-, hacc, hint⟩ := hIH.sound t ht
                      exact (accepts_curP hacc).2 v t.2 rfl hint
                    · intro t hlast
                      rw [List.getLast?_cons] at hlast
                      cases hl : (probeLoop p0 spec rest (some v)
                          (s'.withPrev (some a))).sols.getLast? with
                      | none =>
                          have hnil : (probeLoop p0 spec rest (some v)
                              (s'.withPrev (some a))).sols = [] :=
                            List.getLast?_eq_none_iff.mp hl
                          have hbo := hIH.nil hnil
                          have ht : t = (a, v) := by
                            simpa [hl] using hlast.symm
                          subst ht
                          simpa using hbo
                      | some u =>
                          have hbo := hIH.last u hl
                          have ht : t = u := by
                            simpa [hl] using hlast.symm
                          subst ht
                          exact hbo
                    · intro hnil
                      simp at hnil
                | bool b =>
                    rw [probeLoop_sat_other_eq hc
                      (by intro v hv'; rw [hv] at hv'; cases hv')]
                    exact ⟨by intro t ht; simp at ht, by simp,
                      by intro t ht; simp at ht, fun _ => rfl, hseed⟩
                | setOfInt st =>
                    rw [probeLoop_sat_other_eq hc
                      (by intro v hv'; rw [hv] at hv'; cases hv')]
                    exact ⟨by intro t ht; simp at ht, by simp,
                      by intro t ht; simp at ht, fun _ => rfl, hseed⟩
                | array arr =>
                    rw [probeLoop_sat_other_eq hc
                      (by intro v hv'; rw [hv] at hv'; cases hv')]
                    exact ⟨by intro t ht; simp at ht, by simp,
                      by intro t ht; simp at ht, fun _ => rfl, hseed⟩

structure PortfolioRun (p0 : CompiledProblem DomConstraint) where
  sols : List (List Value × Int)
  complete : Bool
  lastBound : Option Int
  finalStart : Option Int × SeedDb p0.domains
  /-- the final complete segment's per-round learned-database size trace -/
  seeds : List Nat
  /-- number of budgeted probe segments actually attempted -/
  probes : Nat

def portfolioRun (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec)
    (segs : List BudgetSegment) (final : SearchConfig)
    (bo : Option Int) (s : SeedDb p0.domains) : PortfolioRun p0 :=
  let pr := probeLoop p0 spec segs bo s
  let fr := optLoopSeed (lcgSeedSolverConfig final) p0 spec pr.bo pr.seed
  ⟨pr.sols ++ fr.1.sols, fr.1.complete, fr.1.lastBound, (pr.bo, pr.seed), fr.2,
    pr.probes⟩

structure PortfolioInv (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec)
    (bo : Option Int) (final : SearchConfig) (r : PortfolioRun p0) : Prop where
  sound : ∀ t ∈ r.sols, t.1 ∈ allAssigns p0.domains ∧ accepts p0 t.1 = true ∧
    t.1[spec.slot]? = some (.int t.2) ∧
    ∀ b, bo = some b → betterB spec.dir t.2 b = true
  pairwise : r.sols.Pairwise (fun t u => betterB spec.dir u.2 t.2 = true)
  optimal : r.complete = true →
    ∀ b ∈ allAssigns p0.domains, accepts (curP p0 spec r.lastBound) b = false
  nil_bound : r.sols = [] → r.lastBound = bo
  last_bound : ∀ t, r.sols.getLast? = some t → r.lastBound = some t.2

theorem portfolioRun_inv (p0 : CompiledProblem DomConstraint) (spec : ObjectiveSpec)
    (segs : List BudgetSegment) (final : SearchConfig) (bo : Option Int)
    (s : SeedDb p0.domains) :
    LearnedEntailed (lcgLeaf (curP p0 spec bo)) s.clauses →
    PortfolioInv p0 spec bo final (portfolioRun p0 spec segs final bo s) := by
  intro hseed
  let pr := probeLoop p0 spec segs bo s
  let fr := optLoopSeed (lcgSeedSolverConfig final) p0 spec pr.bo pr.seed
  have hinvP : ProbeInv p0 spec bo s pr := probeLoop_inv p0 spec segs bo s hseed
  have hinvF : SeedRunInv (lcgSeedSolverConfig final) p0 spec pr.bo pr.seed fr :=
    optLoopSeed_inv (lcgSeedSolverConfig final) p0 spec _ pr.bo pr.seed rfl
      hinvP.seed_ent
  change PortfolioInv p0 spec bo final
    ⟨pr.sols ++ fr.1.sols, fr.1.complete, fr.1.lastBound, (pr.bo, pr.seed), fr.2,
      pr.probes⟩
  have hprobe_sound : ∀ t ∈ pr.sols, t.1 ∈ allAssigns p0.domains ∧
      accepts (curP p0 spec bo) t.1 = true ∧ t.1[spec.slot]? = some (.int t.2) :=
    hinvP.sound
  have hprobe_pw := hinvP.pairwise
  have hfinal_sound := hinvF.sound
  have hfinal_pw := hinvF.pairwise
  refine ⟨?_, ?_, hinvF.optimal, ?_, ?_⟩
  · intro t ht
    rcases List.mem_append.mp ht with ht | ht
    · obtain ⟨hmem, hacc, hint⟩ := hprobe_sound t ht
      obtain ⟨haccP, hbo⟩ := accepts_curP hacc
      exact ⟨hmem, haccP, hint, fun b hb => hbo b t.2 hb hint⟩
    · obtain ⟨hmem, haccP, hint, hbo⟩ := hfinal_sound t ht
      refine ⟨hmem, haccP, hint, fun b hb => ?_⟩
      by_cases hp : pr.sols = []
      · have hboeq := hinvP.nil hp
        rw [hboeq] at hbo
        exact hbo b hb
      · have hlast : ∃ last, pr.sols.getLast? = some last := by
          cases hl : pr.sols.getLast? with
          | none => exact absurd (List.getLast?_eq_none_iff.mp hl) hp
          | some last => exact ⟨last, rfl⟩
        obtain ⟨last, hlast⟩ := hlast
        have hprbo := hinvP.last last hlast
        have hbetter := hbo last.2 (by rw [hprbo])
        obtain ⟨-, haccLast, hintLast⟩ := hprobe_sound last
          (List.mem_of_getLast? hlast)
        have hlast_better : betterB spec.dir last.2 b = true :=
          (accepts_curP haccLast).2 b last.2 hb hintLast
        exact betterB_trans hbetter hlast_better
  · rw [List.pairwise_append]
    refine ⟨hprobe_pw, hfinal_pw, fun t ht u hu => ?_⟩
    by_cases hp : pr.sols = []
    · rw [hp] at ht
      cases ht
    · have hlast : ∃ last, pr.sols.getLast? = some last := by
        cases hl : pr.sols.getLast? with
        | none => exact absurd (List.getLast?_eq_none_iff.mp hl) hp
        | some last => exact ⟨last, rfl⟩
      obtain ⟨last, hlast⟩ := hlast
      have hprbo := hinvP.last last hlast
      have hbetter : betterB spec.dir u.2 last.2 = true :=
        (hfinal_sound u hu).2.2.2 last.2 (by rw [hprbo])
      exact betterB_of_pairwise_last pr.sols u.2 last hprobe_pw hlast hbetter t ht
  · intro hnil
    have hfr_nil : fr.1.sols = [] := (List.append_eq_nil_iff.mp hnil).2
    have hpr_nil : pr.sols = [] := (List.append_eq_nil_iff.mp hnil).1
    have hlast := hinvF.nil_bound hfr_nil
    have hboeq := hinvP.nil hpr_nil
    rw [hboeq] at hlast
    exact hlast
  · intro t hlast
    by_cases hfr : fr.1.sols = []
    · rw [List.getLast?_append, hfr] at hlast
      change none.or pr.sols.getLast? = some t at hlast
      rw [Option.none_or] at hlast
      have hprlast := hinvP.last t hlast
      have hbound := hinvF.nil_bound hfr
      rw [hbound, hprlast]
    · have hfr_nonempty : fr.1.sols.getLast? ≠ none := by
        intro hl
        exact hfr (List.getLast?_eq_none_iff.mp hl)
      rw [List.getLast?_append] at hlast
      cases hl : fr.1.sols.getLast? with
      | none => exact absurd hl hfr_nonempty
      | some u =>
          simp only [hl, Option.some_or] at hlast
          have ht : t = u := (Option.some.inj hlast).symm
          rw [ht]
          exact hinvF.last_bound u hl


/-- The result of the source-level restart/portfolio driver.  `sols` are the
certified incumbents in discovery order; `complete` is the final complete
segment's flag; `lastBound` is the bound its final round started from; and
`seeds` is the final complete segment's per-round learned-database size
trace.  The budgeted probe segments are not covered by `seeds`; `probes` is
the number of budgeted probe segments actually attempted (the loop stops
early when a probe returns UNSAT or FAIL). -/
structure PortfolioSummary where
  p : CompiledProblem DomConstraint
  sols : List (List Value × Int)
  complete : Bool
  lastBound : Option Int
  seeds : List Nat
  /-- number of budgeted probe segments actually attempted -/
  probes : Nat

/-- The restart/portfolio driver for a source model.  `entries` are budgeted
probe segments; they run in order from the empty seed on ONE fixed
presentation, namely that of `final` (an entry's own value presentation is not
used, only its priority vector and activity-bump toggle).  `final` is then the
complete certified route, started from the carried incumbent bound and seed.
Only the final complete segment may support a completeness or optimality
claim. -/
def optimizePortfolioConfig (entries : List BudgetSegment) (final : SearchConfig)
    (m : Model) : Except String PortfolioSummary :=
  match compileModelOpt m with
  | .error e => .error e
  | .ok (p, spec) =>
      let p' := lcgConfigProblem p final
      let r := portfolioRun p' spec entries final none (SeedDb.nil p'.domains)
      .ok ⟨p, r.sols, r.complete, r.lastBound, r.seeds, r.probes⟩

/-- The restart driver: the portfolio driver on the schedule's segments, with
the same configuration as the final complete route.  `none` is exactly the
complete configured run. -/
def optimizeRestartConfig (kind : RestartKind) (base count : Nat)
    (o : SearchConfig) (m : Model) : Except String PortfolioSummary :=
  optimizePortfolioConfig (restartSegments kind base count o) o m

/-- CLI-ready restart entry: `--restart`/`--restart-base` at the frozen
schedule length, with the same configuration on the final complete route.
`--restart=none` is exactly the complete configured seeded route. -/
def optimizeRestartConfigOf (o : SearchConfig) (m : Model) :
    Except String PortfolioSummary :=
  optimizeRestartConfig (RestartKind.ofStrategy o.restart) o.restartBase
    restartProbeCount o m

@[simp] theorem optimizeRestartConfig_eq (kind : RestartKind) (base count : Nat)
    (o : SearchConfig) (m : Model) :
    optimizeRestartConfig kind base count o m
      = optimizePortfolioConfig (restartSegments kind base count o) o m := rfl

@[simp] theorem optimizeRestartConfigOf_eq (o : SearchConfig) (m : Model) :
    optimizeRestartConfigOf o m
      = optimizePortfolioConfig
          (restartSegments (RestartKind.ofStrategy o.restart) o.restartBase
            restartProbeCount o) o m := rfl

/-- Unfolding of `optimizePortfolioConfig` at a successful compile. -/
theorem optimizePortfolioConfig_inv {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩) :
    ∃ spec : ObjectiveSpec, compileModelOpt m = .ok (p, spec) ∧
      (portfolioRun (lcgConfigProblem p final) spec entries final none
        (SeedDb.nil (lcgConfigProblem p final).domains)).sols = sols ∧
      (portfolioRun (lcgConfigProblem p final) spec entries final none
        (SeedDb.nil (lcgConfigProblem p final).domains)).complete = complete ∧
      (portfolioRun (lcgConfigProblem p final) spec entries final none
        (SeedDb.nil (lcgConfigProblem p final).domains)).lastBound = lastBound ∧
      (portfolioRun (lcgConfigProblem p final) spec entries final none
        (SeedDb.nil (lcgConfigProblem p final).domains)).seeds = seeds ∧
      (portfolioRun (lcgConfigProblem p final) spec entries final none
        (SeedDb.nil (lcgConfigProblem p final).domains)).probes = probes := by
  unfold optimizePortfolioConfig at h
  cases hc : compileModelOpt m with
  | error e => rw [hc] at h; cases h
  | ok r =>
      obtain ⟨p', spec⟩ := r
      rw [hc] at h
      simp only [Except.ok.injEq] at h
      obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ := h
      exact ⟨spec, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- Every emitted solution of a restart/portfolio run is a store satisfying
the source model, with the reported objective value. -/
theorem optimizePortfolioConfig_solution_sound {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩)
    (hwf : WellFormed fullSig m) {t : List Value × Int} (ht : t ∈ sols) :
    Satisfies fullSig fullInterp m (p.toStore t.1) ∧
    LeanFzn.Semantics.ParamHonest m (p.toStore t.1) ∧
    m.solve.objective (p.toStore t.1) = some t.2 := by
  obtain ⟨spec, hc, hsols, -, -, -, -⟩ := optimizePortfolioConfig_inv h
  let p' := lcgConfigProblem p final
  have hinv := portfolioRun_inv p' spec entries final none (SeedDb.nil p'.domains)
    (SeedDb.nil_entailed ((lcgSeedSolverConfig final).leaf (curP p' spec none))
      p'.domains)
  rw [← hsols] at ht
  obtain ⟨hmem, hacc, hv, -⟩ := hinv.sound t ht
  have hmemP : t.1 ∈ allAssigns p.domains :=
    (mem_allAssigns_lcgConfigProblem p final t.1).mp hmem
  have haccP : accepts p t.1 = true := by
    simpa [p', accepts_lcgConfigProblem] using hacc
  obtain ⟨hsat, hpar, i, hi, hai⟩ := compileOpt_exact hc hwf hmemP haccP
  rw [hv] at hai
  have : t.2 = i := by simpa using hai
  subst this
  exact ⟨⟨hwf, hsat⟩, hpar, hi⟩

/-- The objective strictly improves along a restart/portfolio run's emitted
sequence. -/
theorem optimizePortfolioConfig_improving {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩) :
    ∃ spec : ObjectiveSpec,
      sols.Pairwise (fun t u => betterB spec.dir u.2 t.2 = true) := by
  obtain ⟨spec, -, hsols, -, -, -, -⟩ := optimizePortfolioConfig_inv h
  let p' := lcgConfigProblem p final
  refine ⟨spec, ?_⟩
  rw [← hsols]
  exact (portfolioRun_inv p' spec entries final none (SeedDb.nil p'.domains)
    (SeedDb.nil_entailed ((lcgSeedSolverConfig final).leaf (curP p' spec none))
      p'.domains)).pairwise

/-- A completed restart/portfolio run's last solution is an optimal solution
of the source model.  The claim comes only from the final complete certified
segment; the budgeted probes carry sound incumbents but never a proof. -/
theorem optimizePortfolioConfig_optimal {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩)
    (hwf : WellFormed fullSig m) (hcomp : complete = true)
    {t : List Value × Int} (hlast : sols.getLast? = some t) :
    IsSolution fullSig fullInterp m (p.toStore t.1) := by
  obtain ⟨spec, hc, hsols, hcomp', -, -, -⟩ := optimizePortfolioConfig_inv h
  let p' := lcgConfigProblem p final
  have hinv := portfolioRun_inv p' spec entries final none (SeedDb.nil p'.domains)
    (SeedDb.nil_entailed ((lcgSeedSolverConfig final).leaf (curP p' spec none))
      p'.domains)
  rw [← hsols] at hlast
  rw [← hcomp'] at hcomp
  have ht : t ∈ (portfolioRun p' spec entries final none
      (SeedDb.nil p'.domains)).sols := List.mem_of_getLast? hlast
  obtain ⟨hmem, hacc, hv, -⟩ := hinv.sound t ht
  have hlb := hinv.last_bound t hlast
  have hopt := hinv.optimal hcomp
  rw [hlb] at hopt
  have hmemP : t.1 ∈ allAssigns p.domains :=
    (mem_allAssigns_lcgConfigProblem p final t.1).mp hmem
  have haccP : accepts p t.1 = true := by
    simpa [p', accepts_lcgConfigProblem] using hacc
  have hoptP : ∀ b ∈ allAssigns p.domains,
      accepts (p.addConstraint (spec.improveBound t.2)) b = false := by
    intro b hb
    have hb' : b ∈ allAssigns p'.domains :=
      (mem_allAssigns_lcgConfigProblem p final b).mpr hb
    have hbnd : accepts (curP p' spec (some t.2)) b = false := by
      simpa [p'] using hopt b hb'
    rw [accepts_curP_lcgConfigProblem p final spec (some t.2) b] at hbnd
    simpa [curP] using hbnd
  exact compileOpt_optimal hc hwf hmemP haccP hv hoptP

/-- A completed restart/portfolio run without solutions proves the source
model has no parameter-honest satisfying store. -/
theorem optimizePortfolioConfig_unsat {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩)
    (hwf : WellFormed fullSig m) (hcomp : complete = true) (hnil : sols = []) :
    ¬ ∃ store, Satisfies fullSig fullInterp m store ∧
      LeanFzn.Semantics.ParamHonest m store := by
  obtain ⟨spec, hc, hsols, hcomp', -, -, -⟩ := optimizePortfolioConfig_inv h
  let p' := lcgConfigProblem p final
  have hinv := portfolioRun_inv p' spec entries final none (SeedDb.nil p'.domains)
    (SeedDb.nil_entailed ((lcgSeedSolverConfig final).leaf (curP p' spec none))
      p'.domains)
  rw [← hsols] at hnil
  rw [← hcomp'] at hcomp
  have hlb := hinv.nil_bound hnil
  have hopt := hinv.optimal hcomp
  rw [hlb] at hopt
  rintro ⟨store, hs, hph⟩
  obtain ⟨b, hb, hbacc, -⟩ := compileOpt_covers hc hwf hs.2 hph
  have hb' : b ∈ allAssigns p'.domains :=
    (mem_allAssigns_lcgConfigProblem p final b).mpr hb
  have : accepts p b = false := by
    have hbnd : accepts (curP p' spec none) b = false := by
      simpa [p'] using hopt b hb'
    rw [accepts_curP_lcgConfigProblem p final spec none b] at hbnd
    simpa [curP] using hbnd
  rw [hbacc] at this
  cases this

/-- Totality: with the compiled gate satisfied, a restart/portfolio run always
reaches a terminal state: the final complete segment never `fail`s and never
stops on an unreadable objective. -/
theorem optimizePortfolioConfig_total {entries : List BudgetSegment}
    {final : SearchConfig} {m : Model}
    {p : CompiledProblem DomConstraint} {sols : List (List Value × Int)}
    {complete : Bool} {lastBound : Option Int} {seeds : List Nat}
    {probes : Nat}
    (h : optimizePortfolioConfig entries final m
      = .ok ⟨p, sols, complete, lastBound, seeds, probes⟩)
    (hwf : WellFormed fullSig m) (hg : gateOk (lcgProblem p) = true) :
    complete = true := by
  obtain ⟨spec, hc, -, hcomp', -, -, -⟩ := optimizePortfolioConfig_inv h
  let p' := lcgConfigProblem p final
  have hread : ∀ a ∈ allAssigns p'.domains, accepts p' a = true →
      ∃ i : Int, a[spec.slot]? = some (.int i) := by
    intro a hmem hacc
    have hmemP : a ∈ allAssigns p.domains :=
      (mem_allAssigns_lcgConfigProblem p final a).mp hmem
    have haccP : accepts p a = true := by
      simpa [p', accepts_lcgConfigProblem] using hacc
    obtain ⟨-, -, i, -, hai⟩ := compileOpt_exact hc hwf hmemP haccP
    exact ⟨i, hai⟩
  have hfin := optLoopSeed_complete (lcgSeedSolverConfig final) p' spec
    (lcgSeedSolverConfig_gate hg) hread
    (meas p' spec (probeLoop p' spec entries none (SeedDb.nil p'.domains)).bo)
    (probeLoop p' spec entries none (SeedDb.nil p'.domains)).bo
    (probeLoop p' spec entries none (SeedDb.nil p'.domains)).seed rfl
  rw [← hcomp']
  exact hfin

end LeanFzn.Integration
