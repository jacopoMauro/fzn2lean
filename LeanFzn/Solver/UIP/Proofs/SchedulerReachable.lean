/-
File: LeanFzn/Solver/UIP/Proofs/SchedulerReachable.lean

Purpose:
  EXECUTION REACHABILITY of the certified first-UIP scheduler, generated by
  the actual transition equations, together with its conflict-evidence
  provenance and phase location.

  What this module fixes (PLAN.md R1 acceptance gate):

  * `SchedulerReachable cfg` is the least predicate generated by
    `SchedulerConfig.init` and the REAL dispatcher equations
    (`schedulerNext cfg = t`, `t.successor = some cfg'`). The constructors
    carry NO invariant/progress/correctness conclusion: invariant
    preservation is S1-S5's obligation, progress is P3-P5's, and the
    terminal verdicts are S5/W1's.
  * `schedulerReachable_init` is the non-vacuous root witness (it is the
    real initializer with the real frontier, cf. `SchedulerInvariant`).
  * PHASE LOCATION: the dispatch arms taken by the real equations
    (`schedulerNext_eq_backjumpStep_of_conflict_some`,
    `schedulerNext_eq_consumeStep_of_dead`), so "where a reachable
    configuration sits in the phase machine" is a theorem about
    `schedulerNext`, not a constructor field.
  * CONFLICT-EVIDENCE PROVENANCE: the recording site's evidence is exactly
    the NORMALIZED computed-allowance analysis (`stepAnalyzeConflict_evidence`),
    the per-transition conflict-field equations, and the reachability
    induction `evidenceProvenance_of_reachable`: any recorded evidence on a
    reachable configuration is the computed-allowance record of that
    configuration's own branch. `reachable_analysis_success` turns that
    into the success bridge S3 consumes (`∃ below uip,
    analyzeAtAllowance … = some (below, uip) ∧ an = (ofUIP below uip).normalized`).
  * F1 EXCLUSION: `ConflictAnalysis.ofUIP` always records a NONEMPTY
    learned clause (`ofUIP_learned_ne_nil`), so F1's fabricated
    empty-learned "successful" analysis cannot be a UIP record; on
    reachable configurations no recorded `some an` has `an.learned = []`
    (`analysisSuccess_learned_ne_nil`). The remaining F1 residual
    (reachability of the witness CONFIGURATION itself) is recorded below
    as a named proposition with its required owner.
  * P5 CONSUMER INTERFACE: `ReachablePhaseProgress` states progress on
    REACHABLE execution only, over the phase dispatcher and the C3a rank
    (`RankLt`/`SchedulerRank`); R1 exports the statement, P5 owns the
    proof.

  Reused, NOT conflated: `ReachableState` (`Proofs/BranchState.lean`) is
  per-BRANCH coherence; `SchedulerReachable` is per-CONFIGURATION and only
  its transition content is asserted here.

Dependencies:
  - LeanFzn.Solver.UIP.Proofs.Scheduler: `schedulerNext`, `phaseNext`,
    `SchedulerTransition.successor`, C3a's `SchedulerRank`/`RankLt`
  - LeanFzn.Solver.UIP.Proofs.SchedulerInvariant: `SchedulerInvariant`, root facts

DAG:
  Proofs.Scheduler -> Proofs.SchedulerReachable (this module; consumed by
  L1/L2, S1-S5, P1, P5). No runtime module imports it. Registration in the
  umbrella `LeanFzn.Solver/LeanFzn.Solver.UIP.lean` is the coordinator's import line:
    import LeanFzn.Solver.UIP.Proofs.SchedulerReachable
-/

import LeanFzn.Solver.UIP.Proofs.Scheduler
import LeanFzn.Solver.UIP.Proofs.SchedulerInvariant
open LeanFzn.Solver.Propagation.DomainFiltering LeanFzn.Semantics LeanFzn.Semantics.Evaluation LeanFzn.Solver.Propagation LeanFzn.Solver.UIP


namespace LeanFzn.Solver.UIP
open LeanFzn.Semantics LeanFzn.Solver.Core LeanFzn.Solver.Propagation LeanFzn.Solver.Propagation.DomainFiltering
open LeanFzn LeanFzn.Solver.Core
open LeanFzn.Solver.Propagation LeanFzn.Solver.UIP LeanFzn.Solver.UIP.C3a

/-! ## §1 Execution reachability (actual transition equations) -/

/-- Execution reachability of the scheduler: the least predicate generated
by supported initialization (the real `SchedulerConfig.init`) and the real
dispatcher equations. The step constructor states exactly the executable
content — a direct successor of `schedulerNext` — and NOTHING else: no
invariant, progress or correctness conclusion is a field here (PLAN.md R1:
"defer invariant preservation to S1-S5"). -/
inductive SchedulerReachable {leaf : Assignment → Bool} :
    SchedulerConfig leaf → Prop where
  /-- supported initialization: the real root configuration -/
  | init (orig : List Domain) (original : List Clause) (props : List Propagator)
      (hent : LearnedEntailed leaf original) :
      SchedulerReachable (SchedulerConfig.init orig original props)
  /-- one real dispatcher step: `schedulerNext` produced `t` and `t`'s
      successor is `cfg'` (terminal transitions have no successor) -/
  | step {cfg cfg' : SchedulerConfig leaf} {t : SchedulerTransition leaf} :
      schedulerNext cfg = t → t.successor = some cfg' →
      SchedulerReachable cfg → SchedulerReachable cfg'

/-- The non-vacuous root witness: supported initialization is reachable.
This is the real initializer (whole original box, empty trail, level zero,
root checkpoint registered), so the predicate has at least one inhabitant
for every input — the reachability construct itself is not vacuous. -/
theorem schedulerReachable_init (orig : List Domain) (original : List Clause)
    (props : List Propagator) (hent : LearnedEntailed leaf original) :
    SchedulerReachable (SchedulerConfig.init (leaf := leaf) orig original props) :=
  SchedulerReachable.init orig original props hent

/-- Reachability is closed under one real dispatcher step — the shape S5's
induction consumes, with the dispatcher's successor equation supplied
directly (no separate transition witness). -/
theorem schedulerReachable_successor {cfg cfg' : SchedulerConfig leaf}
    (h : SchedulerReachable cfg)
    (hs : (schedulerNext cfg).successor = some cfg') :
    SchedulerReachable cfg' :=
  SchedulerReachable.step rfl hs h

/-! ## §2 Phase location from the real dispatch

Which phase machine arm a configuration sits in is a theorem about the
real dispatch equations, NOT a reachability constructor field. -/

/-- PHASE LOCATION (evidence recorded): whenever evidence is recorded, the
dispatcher's next step is the evidence-resolving `backjumpStep`. -/
theorem schedulerNext_eq_backjumpStep_of_conflict_some {cfg : SchedulerConfig leaf}
    {ev : ConflictEvidence} (h : cfg.conflict = some ev) :
    schedulerNext cfg = backjumpStep cfg ev := by
  simp only [schedulerNext, h]

/-- PHASE LOCATION (consume pending): a dead branch with no recorded
evidence takes the consume dispatch. -/
theorem schedulerNext_eq_consumeStep_of_dead {cfg : SchedulerConfig leaf}
    (hc : cfg.conflict = none) (hs : cfg.status = .dead) :
    schedulerNext cfg = consumeStep cfg := by
  simp only [schedulerNext, hc, hs]

/-! ## §3 Conflict-field equations of the transition functions -/

@[simp] theorem stepPropagate_conflict (cfg : SchedulerConfig leaf)
    (d : ProductiveDeduction leaf cfg.branch) :
    (stepPropagate cfg d).conflict = cfg.conflict := rfl

@[simp] theorem stepDecide_conflict (cfg : SchedulerConfig leaf) (v : Value)
    (vs : Domain) (doms : List Domain) (l : Literal) :
    (stepDecide cfg v vs doms l).conflict = cfg.conflict := rfl

@[simp] theorem stepDecideSkip_conflict (cfg : SchedulerConfig leaf) (v : Value)
    (doms : List Domain) :
    (stepDecideSkip cfg v doms).conflict = cfg.conflict := rfl

/-- The recording site: `stepAnalyzeConflict` stores the NORMALIZED
computed-allowance analysis of the branch's own trail/level, mapped through
`ofUIP` and `ConflictAnalysis.normalized`. -/
@[simp] theorem stepAnalyzeConflict_conflict_eq (cfg : SchedulerConfig leaf)
    (c : Clause) (learned : List Clause) :
    (stepAnalyzeConflict cfg c learned).conflict =
      some { clause := c, learned := learned,
             analysis := recordedAnalysis cfg c } := rfl

/-! NOTE: `stepAnalyzeConflict_branch` and `stepLearnBackjumpAssert_conflict`
already exist (SchedulerStep.lean :428, :475) and are reused, not
redeclared. -/

@[simp] theorem stepLocalExclude_conflict (cfg : SchedulerConfig leaf)
    (learned : List Clause) (r : DeadRegion) :
    (stepLocalExclude cfg learned r).conflict = none := rfl

@[simp] theorem stepChronologicalFallback_conflict (cfg : SchedulerConfig leaf)
    (r : DeadRegion) :
    (stepChronologicalFallback cfg r).conflict = none := rfl

/-- The consume successor carries no recorded evidence. -/
theorem stepConsume_conflict {cfg cfg' : SchedulerConfig leaf}
    (h : stepConsume cfg = some cfg') : cfg'.conflict = none := by
  cases hp : cfg.pending with
  | nil => simp [stepConsume, hp] at h
  | cons f rest =>
      simp only [stepConsume, hp] at h
      injection h with h
      rw [← h]

/-- A `stableStep` successor carries no recorded evidence (given the
predecessor had none): the leaf arm is terminal, the split arm inherits,
the local-exclusion arm clears. -/
theorem stableStep_successor_conflict_none {cfg cfg' : SchedulerConfig leaf}
    (hc : cfg.conflict = none) (h : (stableStep cfg).successor = some cfg') :
    cfg'.conflict = none := by
  unfold stableStep at h
  cases hl : leafWitness leaf cfg with
  | some w =>
      simp only [hl, successor_sat] at h
      cases h
  | none =>
      cases hs : splitData cfg.branch.frame with
      | some p =>
          obtain ⟨l, v, vs, doms⟩ := p
          simp only [hl, hs] at h
          rw [successor_decide] at h
          cases h
          rw [stepDecide_conflict, hc]
      | none =>
          simp only [hl, hs] at h
          rw [successor_localExclude] at h
          cases h
          rfl

/-- The GUARDED stable dispatch's successor carries no recorded evidence
either (B1): the redundant arm's `stepDecideSkip` inherits the field. -/
theorem stableStepGuarded_successor_conflict_none {cfg cfg' : SchedulerConfig leaf}
    (hc : cfg.conflict = none) (h : (stableStepGuarded cfg).successor = some cfg') :
    cfg'.conflict = none := by
  unfold stableStepGuarded at h
  cases hl : leafWitness leaf cfg with
  | some w =>
      simp only [hl, successor_sat] at h
      cases h
  | none =>
      cases hs : splitData cfg.branch.frame with
      | some p =>
          obtain ⟨l, v, vs, doms⟩ := p
          simp only [hl, hs] at h
          split at h
          · rw [successor_decide] at h
            cases h
            rw [stepDecideSkip_conflict, hc]
          · rw [successor_decide] at h
            cases h
            rw [stepDecide_conflict, hc]
      | none =>
          simp only [hl, hs] at h
          rw [successor_localExclude] at h
          cases h
          rfl

/-- A `conflictStep` successor either carries no recorded evidence, or is
exactly the recording site's successor of the SAME branch (the level-0
`.unsat` arm is terminal). -/
theorem conflictStep_successor_conflict {cfg cfg' : SchedulerConfig leaf}
    {cs : List Clause} {learned : List Clause}
    (_hc : cfg.conflict = none)
    (h : (conflictStep cfg cs learned).successor = some cfg') :
    cfg'.conflict = none ∨
      ∃ c rest, cs = c :: rest ∧
        cfg' = stepAnalyzeConflictCounted cfg c learned
          (analyzeEventsExpansions cfg.orig cfg.branch.trail cfg.branch.level c) := by
  cases cs with
  | nil =>
      simp only [conflictStep] at h
      rw [successor_localExclude] at h
      cases h
      exact Or.inl rfl
  | cons c rest =>
      by_cases hl : cfg.branch.level = 0
      · simp only [conflictStep, if_pos hl, successor_unsat] at h
        cases h
      · simp only [conflictStep, if_neg hl] at h
        rw [successor_analyzeConflict] at h
        cases h
        exact Or.inr ⟨c, rest, rfl, rfl⟩

/-- A consume-dispatch successor carries no recorded evidence. -/
theorem consumeStep_successor_conflict {cfg cfg' : SchedulerConfig leaf}
    (h : (consumeStep cfg).successor = some cfg') : cfg'.conflict = none := by
  cases hs : stepConsume cfg with
  | none =>
      simp only [consumeStep, hs] at h
      cases h
  | some next =>
      simp only [consumeStep, hs] at h
      rw [successor_chronologicalFallback] at h
      cases h
      exact stepConsume_conflict hs

/-- A backjump-dispatch successor carries no recorded evidence: all three
landings (`chronologicalFallback`, `localExclude`, `learnBackjumpAssert`)
clear the evidence field. -/
theorem backjumpStep_successor_conflict_none {cfg : SchedulerConfig leaf}
    {ev : ConflictEvidence} {cfg' : SchedulerConfig leaf}
    (h : (backjumpStep cfg ev).successor = some cfg') : cfg'.conflict = none := by
  cases ha : ev.analysis with
  | none =>
      simp only [backjumpStep, ha] at h
      rw [successor_chronologicalFallback] at h
      cases h
      rfl
  | some an =>
      cases hc : checkpointAt cfg.checkpoints an.backjumpLevel with
      | none =>
          simp only [backjumpStep, ha, hc] at h
          rw [successor_chronologicalFallback] at h
          cases h
          rfl
      | some cp =>
          cases hp : (BackjumpPlan.ofCheckpoint cp cfg.branch an.asserting
              an.learned).perform cfg.branch cfg.orig cfg.original cfg.props with
          | none =>
              simp only [backjumpStep, ha, hc, hp] at h
              rw [successor_localExclude] at h
              cases h
              rfl
          | some restored =>
              simp only [backjumpStep, ha, hc, hp] at h
              rw [successor_learnBackjumpAssert] at h
              cases h
              rfl

/-- SUCCESSOR CLASSIFICATION of the real dispatcher from a configuration
with no recorded evidence: every non-terminal successor either carries no
evidence, or is the recording site's successor (`stepAnalyzeConflict`) of
the same branch. This is the single equation-level fact the reachability
provenance induction consumes. -/
theorem schedulerNext_successor_conflict_classification {cfg : SchedulerConfig leaf}
    {cfg' : SchedulerConfig leaf} {t : SchedulerTransition leaf}
    (hc : cfg.conflict = none) (hnext : schedulerNext cfg = t)
    (hsucc : t.successor = some cfg') :
    cfg'.conflict = none ∨
      ∃ (c : Clause) (learned : List Clause),
        cfg' = stepAnalyzeConflictCounted cfg c learned
          (analyzeEventsExpansions cfg.orig cfg.branch.trail cfg.branch.level c) := by
  cases hst : cfg.status with
  | dead =>
      have ht : consumeStep cfg = t := by
        simp only [schedulerNext, hc, hst] at hnext
        exact hnext
      rw [← ht] at hsucc
      exact Or.inl (consumeStep_successor_conflict hsucc)
  | active =>
      cases hd : explainedDeduction cfg.original cfg.props cfg.branch with
      | some d =>
          have ht : SchedulerTransition.propagate (stepPropagate cfg d) = t := by
            simp only [schedulerNext, hc, hst, hd] at hnext
            exact hnext
          rw [← ht] at hsucc
          rw [successor_propagate] at hsucc
          cases hsucc
          exact Or.inl (by rw [stepPropagate_conflict, hc])
      | none =>
          cases htt : terminalResult cfg.orig cfg.original cfg.props cfg.branch with
          | stable st =>
              have ht : stableStepGuarded cfg = t := by
                simp only [schedulerNext, hc, hst, hd, htt] at hnext
                exact hnext
              rw [← ht] at hsucc
              exact Or.inl (stableStepGuarded_successor_conflict_none hc hsucc)
          | conflict st cs learned =>
              have ht : conflictStep cfg cs learned = t := by
                simp only [schedulerNext, hc, hst, hd, htt] at hnext
                exact hnext
              rw [← ht] at hsucc
              rcases conflictStep_successor_conflict hc hsucc with
                hnone | ⟨c, rest, -, heq⟩
              · exact Or.inl hnone
              · exact Or.inr ⟨c, learned, heq⟩
          | localExcluded st lit reason learned =>
              have ht :
                  SchedulerTransition.localExclude
                    (stepLocalExclude cfg learned (branchRegion cfg)) = t := by
                simp only [schedulerNext, hc, hst, hd, htt] at hnext
                exact hnext
              rw [← ht] at hsucc
              rw [successor_localExclude] at hsucc
              cases hsucc
              exact Or.inl rfl

/-! ## §4 Conflict-evidence provenance -/

/-- The recording site's evidence, destructured: whenever
`stepAnalyzeConflict` recorded `ev`, the evidence is the reported clause,
the closure's new clauses, and exactly the NORMALIZED computed-allowance
analysis of the recording configuration's own trail and level. -/
theorem stepAnalyzeConflict_evidence {cfg : SchedulerConfig leaf} {c : Clause}
    {learned : List Clause} {ev : ConflictEvidence}
    (h : (stepAnalyzeConflict cfg c learned).conflict = some ev) :
    ev.clause = c ∧ ev.learned = learned ∧
      ev.analysis = recordedAnalysis cfg c := by
  simp only [stepAnalyzeConflict] at h
  injection h with h
  rw [← h]
  exact ⟨rfl, rfl, rfl⟩

/-- Evidence provenance: recorded evidence on a configuration is the
NORMALIZED computed-allowance record of that configuration's OWN branch.
This is the equation S3 needs to turn `cfg.conflict = some ev` into the
analysis result; it is provable from reachability alone (see
`evidenceProvenance_of_reachable`) because the only transition that
installs `some` evidence is the recording site, and the very next real step
resolves it. -/
def EvidenceProvenance {leaf : Assignment → Bool}
    (cfg : SchedulerConfig leaf) : Prop :=
  ∀ ev : ConflictEvidence, cfg.conflict = some ev →
    ev.analysis = recordedAnalysis cfg ev.clause

/-- ONE REAL STEP establishes evidence provenance — unconditionally on the
predecessor (the only transition installing `some` evidence is the
recording site, whose own step resolves it): a successor either carries no
recorded evidence, or is the recording site's successor of the same
branch, where the field equation holds definitionally. -/
theorem evidenceProvenance_of_step {cfg : SchedulerConfig leaf}
    {t : SchedulerTransition leaf} {cfg' : SchedulerConfig leaf}
    (hnext : schedulerNext cfg = t) (hsucc : t.successor = some cfg') :
    EvidenceProvenance cfg' := by
  intro ev' hev'
  cases hcc : cfg.conflict with
  | some ev =>
      have ht : backjumpStep cfg ev = t := by
        simp only [schedulerNext, hcc] at hnext
        exact hnext
      rw [← ht] at hsucc
      have hnone := backjumpStep_successor_conflict_none hsucc
      rw [hnone] at hev'
      cases hev'
  | none =>
      rcases schedulerNext_successor_conflict_classification hcc hnext hsucc with
        hnone | ⟨c, learned, heq⟩
      · rw [hnone] at hev'
        cases hev'
      · subst cfg'
        obtain ⟨hcl, -, hana⟩ := stepAnalyzeConflictCounted_evidence hev'
        rw [hana, hcl]
        rfl

/-- PROVED: every reachable configuration satisfies evidence provenance
(structural induction on reachability, each step discharged by
`evidenceProvenance_of_step`). -/
theorem evidenceProvenance_of_reachable {cfg₀ : SchedulerConfig leaf}
    (h : SchedulerReachable cfg₀) : EvidenceProvenance cfg₀ := by
  induction h with
  | init orig original props =>
      intro ev hev
      simp [SchedulerConfig.init] at hev
  | step hnext hsucc ih =>
      exact evidenceProvenance_of_step hnext hsucc

/-- Unfolding the recording site's analysis: a stored `some an` is the
normalised allowance analysis AND passed the runtime repeat guard. -/
theorem recordedAnalysis_eq_some {cfg : SchedulerConfig leaf} {c : Clause}
    {an : ConflictAnalysis} (h : recordedAnalysis cfg c = some an) :
    ∃ (below : List (Literal × Nat)) (uip : Literal),
      analyzeAtAllowance cfg.orig cfg.branch.trail cfg.branch.level c
        = some (below, uip) ∧
      an = (ConflictAnalysis.ofUIP below uip).normalized ∧
      learnedRepeats cfg an.learned = false := by
  unfold recordedAnalysis at h
  cases hm : analyzeAtAllowance cfg.orig cfg.branch.trail cfg.branch.level c with
  | none => rw [hm] at h; simp at h
  | some p =>
      obtain ⟨below, uip⟩ := p
      rw [hm] at h
      simp only [Option.map_some, Option.filter_some] at h
      split at h
      · rename_i hb
        simp only [Option.some.injEq] at h
        subst h
        exact ⟨below, uip, rfl, rfl, by simpa using hb⟩
      · cases h

/-- The SUCCESS BRIDGE (the analysis-success obligation of S3/S5),
discharged here from provenance: whenever a reachable configuration has an
analysis record `some an`, there IS a computed-allowance run at the
configuration's own trail and level producing exactly `an` through `ofUIP`
in CANONICAL form. -/
def ReachableAnalysisSuccess (leaf : Assignment → Bool) : Prop :=
  ∀ (cfg : SchedulerConfig leaf) (ev : ConflictEvidence) (an : ConflictAnalysis),
    SchedulerReachable cfg → cfg.conflict = some ev → ev.analysis = some an →
      ∃ (below : List (Literal × Nat)) (uip : Literal),
        analyzeAtAllowance cfg.orig cfg.branch.trail cfg.branch.level ev.clause
          = some (below, uip) ∧
        an = (ConflictAnalysis.ofUIP below uip).normalized

/-- PROVED: reachability gives the analysis-success bridge. -/
theorem reachable_analysis_success (leaf : Assignment → Bool) :
    ReachableAnalysisSuccess leaf := by
  intro cfg ev an hreach hconf hana
  have h := evidenceProvenance_of_reachable hreach ev hconf
  rw [hana] at h
  obtain ⟨below, uip, h1, h2, -⟩ := recordedAnalysis_eq_some h.symm
  exact ⟨below, uip, h1, h2⟩

/-- **NOVELTY BY CONSTRUCTION**: at every reachable recorded site the stored
analysis passed the runtime repeat guard against the current database. -/
theorem reachable_analysis_novel {leaf : Assignment → Bool}
    {cfg : SchedulerConfig leaf} {ev : ConflictEvidence} {an : ConflictAnalysis}
    (hreach : SchedulerReachable cfg) (hconf : cfg.conflict = some ev)
    (hana : ev.analysis = some an) : learnedRepeats cfg an.learned = false := by
  have h := evidenceProvenance_of_reachable hreach ev hconf
  rw [hana] at h
  exact (recordedAnalysis_eq_some h.symm).choose_spec.choose_spec.2.2

/-- **ONE REAL STEP** establishes the positive-level fact for recorded
evidence: no induction hypothesis is needed — the only transition
installing evidence is the recording site, whose `conflictStep` guard sends
level-0 conflicts to `.unsat` (no successor); every other arm either clears
the field (contradiction) or keeps it from a predecessor refuted by the
predecessor's `conflict = none` in the active dispatch. -/
theorem recorded_conflict_level_pos_of_step {cfg : SchedulerConfig leaf}
    {t : SchedulerTransition leaf} {cfg' : SchedulerConfig leaf}
    (hnext : schedulerNext cfg = t) (hsucc : t.successor = some cfg') :
    ∀ ev, cfg'.conflict = some ev → 0 < cfg'.branch.level := by
  intro ev' hev'
  cases hcc : cfg.conflict with
  | some ev =>
      have ht : backjumpStep cfg ev = t := by
        simp only [schedulerNext, hcc] at hnext
        exact hnext
      rw [← ht] at hsucc
      have hnone := backjumpStep_successor_conflict_none hsucc
      rw [hnone] at hev'
      cases hev'
  | none =>
      rcases C2d.schedulerNext_cases cfg with
        ⟨ev₀, hc₀, hnev⟩ | ⟨hconf₀, hdead₀, hnc⟩ | ⟨hconf₀, hact₀, hrest⟩
      · rw [hcc] at hc₀
        cases hc₀
      · -- consume route: clears or terminal
        rw [hnext] at hnc
        rw [hnc] at hsucc
        unfold consumeStep at hsucc
        split at hsucc
        · rename_i next hcs
          simp only [successor_chronologicalFallback, Option.some.injEq]
            at hsucc
          subst hsucc
          rw [stepConsume_conflict hcs] at hev'
          cases hev'
        · simp only [successor_unsat] at hsucc
          cases hsucc
      · rcases hrest with
          ⟨d, hd, hnt⟩ | ⟨bs, ht', hnt⟩ | ⟨bs, cs, learned, ht', hnt⟩ |
            ⟨bs, lit, reason, learned, ht', hnt⟩
        · -- propagate keeps the (none) conflict
          rw [hnext] at hnt
          rw [hnt] at hsucc
          simp only [successor_propagate, Option.some.injEq] at hsucc
          subst hsucc
          rw [stepPropagate_conflict] at hev'
          rw [hcc] at hev'
          cases hev'
        · -- guarded stable dispatch
          rw [hnext] at hnt
          rw [hnt] at hsucc
          unfold stableStepGuarded at hsucc
          split at hsucc
          · simp only [successor_sat] at hsucc
            cases hsucc
          · split at hsucc
            · rename_i l v vs doms hsp
              split at hsucc
              · -- skip keeps the conflict
                simp only [successor_decide, Option.some.injEq] at hsucc
                subst hsucc
                rw [stepDecideSkip_conflict] at hev'
                rw [hcc] at hev'
                cases hev'
              · -- fresh decision keeps the conflict
                simp only [successor_decide, Option.some.injEq] at hsucc
                subst hsucc
                rw [stepDecide_conflict] at hev'
                rw [hcc] at hev'
                cases hev'
            · -- localExclude clears
              simp only [successor_localExclude, Option.some.injEq] at hsucc
              subst hsucc
              rw [stepLocalExclude_conflict] at hev'
              cases hev'
        · -- the conflict dispatch
          rw [hnext] at hnt
          rw [hnt] at hsucc
          cases cs with
          | nil =>
              simp only [conflictStep] at hsucc
              simp only [successor_localExclude, Option.some.injEq] at hsucc
              subst hsucc
              rw [stepLocalExclude_conflict] at hev'
              cases hev'
          | cons c rest =>
              by_cases hlv : cfg.branch.level = 0
              · simp only [conflictStep, if_pos hlv, successor_unsat] at hsucc
                cases hsucc
              · -- THE RECORDING SITE: the guard's negation is the level
                simp only [conflictStep, if_neg hlv, successor_analyzeConflict,
                  Option.some.injEq] at hsucc
                subst hsucc
                simpa only [stepAnalyzeConflictCounted, stepAnalyzeConflict,
                  SchedulerConfig.countResolutions]
                  using Nat.pos_of_ne_zero hlv
        · -- localExcluded clears
          rw [hnext] at hnt
          rw [hnt] at hsucc
          simp only [successor_localExclude, Option.some.injEq] at hsucc
          subst hsucc
          rw [stepLocalExclude_conflict] at hev'
          cases hev'

/-- **RECORDED CONFLICTS SIT ABOVE LEVEL 0** (E1's `hpos` ingredient):
proved by induction over reachability, each step discharged by
`recorded_conflict_level_pos_of_step`. -/
theorem recorded_conflict_level_pos {cfg₀ : SchedulerConfig leaf}
    (h : SchedulerReachable cfg₀) :
    ∀ ev, cfg₀.conflict = some ev → 0 < cfg₀.branch.level := by
  induction h with
  | init orig original props =>
      intro ev hev
      simp [SchedulerConfig.init] at hev
  | step hnext hsucc ih =>
      exact recorded_conflict_level_pos_of_step hnext hsucc

/-! ## §5 F1 exclusion: the empty-learned analysis is not a UIP record -/

/-- `ConflictAnalysis.ofUIP` always records a NONEMPTY learned clause: the
negated UIP is consed onto the below-level falsifiers. -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.ofUIP_learned_ne_nil (below : List (Literal × Nat))
    (uip : Literal) : (ConflictAnalysis.ofUIP below uip).learned ≠ [] :=
  List.cons_ne_nil _ _

/-- A normalized record's learned clause is nonempty whenever the raw one
is (`List.map` of a cons is a cons). -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.normalized_learned_ne_nil (an : ConflictAnalysis)
    (h : an.learned ≠ []) : an.normalized.learned ≠ [] := by
  rw [ConflictAnalysis.normalized_learned]
  cases hl : an.learned with
  | nil => exact absurd hl h
  | cons a as => simp

/-- The normalized record's learned clause, unfolded. -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.ofUIP_normalized_learned
    (below : List (Literal × Nat)) (uip : Literal) :
    (ConflictAnalysis.ofUIP below uip).normalized.learned
      = (uip.negate :: below.map fun p => p.1).map Literal.norm := rfl

/-- The empty-below normalized record's learned clause is the singleton of
the normalized negated UIP — the normalized-unit shape of N1. -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.ofUIP_normalized_learned_empty (uip : Literal) :
    (ConflictAnalysis.ofUIP [] uip).normalized.learned = [(uip.negate).norm] := by
  rw [ConflictAnalysis.ofUIP_normalized_learned]
  simp

/-- The `ofUIP` record's fields, packaged (S3/S5 consumers): learned clause,
asserting literal and backjump level are exactly the constructor's. -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.ofUIP_shape (below : List (Literal × Nat))
    (uip : Literal) :
    (ConflictAnalysis.ofUIP below uip).learned
        = uip.negate :: below.map (fun p => p.1) ∧
      (ConflictAnalysis.ofUIP below uip).asserting = uip.negate ∧
      (ConflictAnalysis.ofUIP below uip).backjumpLevel
        = below.foldl (fun acc p => max acc p.2) 0 :=
  ⟨rfl, rfl, rfl⟩

/-- F1 EXCLUSION (record form): a record with an EMPTY learned clause is
outside the image of `ConflictAnalysis.ofUIP`, hence not a successful UIP
record. F1's fabricated analysis (`learned := []`, PLAN.md F1) is therefore
not producible by the computed-allowance entry point. -/
theorem _root_.LeanFzn.Solver.Propagation.ConflictAnalysis.ne_ofUIP_of_learned_eq_nil
    (below : List (Literal × Nat)) (uip : Literal) {an : ConflictAnalysis}
    (h : an.learned = []) : ConflictAnalysis.ofUIP below uip ≠ an := by
  intro he
  rw [← he] at h
  exact ConflictAnalysis.ofUIP_learned_ne_nil below uip h

/-- F1 EXCLUSION (recording-site form): every analysis record stored by
`stepAnalyzeConflict` — whenever the allowance run succeeds — has a
nonempty learned clause. -/
theorem stepAnalyzeConflict_analysis_learned_ne_nil {cfg : SchedulerConfig leaf}
    {c : Clause} {learned : List Clause} {ev : ConflictEvidence}
    {an : ConflictAnalysis}
    (h : (stepAnalyzeConflict cfg c learned).conflict = some ev)
    (ha : ev.analysis = some an) : an.learned ≠ [] := by
  obtain ⟨-, -, hana⟩ := stepAnalyzeConflict_evidence h
  rw [ha] at hana
  obtain ⟨below, uip, -, hen, -⟩ := recordedAnalysis_eq_some hana.symm
  rw [hen]
  exact ConflictAnalysis.normalized_learned_ne_nil _
    (ConflictAnalysis.ofUIP_learned_ne_nil below uip)

/-- F1 EXCLUSION (reachable-execution form): on a reachable configuration,
no recorded analysis `some an` has an empty learned clause — successful
UIP analysis always constructs a nonempty clause, so F1's fabricated
empty-learned evidence can never be the analysis record of a reachable
execution. -/
theorem analysisSuccess_learned_ne_nil {cfg : SchedulerConfig leaf}
    {ev : ConflictEvidence} {an : ConflictAnalysis}
    (hreach : SchedulerReachable cfg) (hconf : cfg.conflict = some ev)
    (hana : ev.analysis = some an) : an.learned ≠ [] := by
  obtain ⟨below, uip, -, heq⟩ :=
    reachable_analysis_success leaf cfg ev an hreach hconf hana
  rw [heq]
  exact ConflictAnalysis.normalized_learned_ne_nil _
    (ConflictAnalysis.ofUIP_learned_ne_nil below uip)

/-- RESIDUAL, recorded by R1 for S2/S3 (NOT proved here): the F1 witness
CONFIGURATION is not reachable. The target statement is

  `¬ SchedulerReachable { SchedulerConfig.init [[1, 2]] [] [] with
       branch := { frame := ([], [1]), trail := [], level := 1,
                   learned := [] },
       checkpoints := [{ level := 0, frame := ([[1, 2]], []), trail := [] }] }`

(PLAN F1's witness of `Proofs/JumpDecrease.lean` §3, with public values
here). NOTE (R1 finding, verified by reading `FrameCovers`/`allAssigns`, not
kernel-checked here): the checkpoint-identity route does NOT refute it —
`FrameCovers ([], [1]) a` forces `a = [1]`, which the witness checkpoint
frame `([[1, 2]], [])` covers, so the witness checkpoint plausibly satisfies
`DecisionCheckpoint.Identifies` at its own level. Hence
`ReachableCheckpointsIdentify` alone is insufficient; a genuine reachability
invariant (e.g. trail/level coherence:
`branch.level ≤ branch.trail.length`, violated by the witness) is needed;
its preservation by `perform` is S3's. -/
def ReachableExcludesF1WitnessShape (leaf : Assignment → Bool) : Prop :=
  ¬ SchedulerReachable
      ({ SchedulerConfig.init (leaf := leaf) [[Value.int 1, Value.int 2]]
            ([] : List Clause) ([] : List Propagator) with
         branch :=
           ({ frame := (([] : List Domain), [Value.int 1]), trail := [],
              level := 1, learned := [] } : BranchState leaf)
         checkpoints :=
           [{ level := 0, frame := ([[Value.int 1, Value.int 2]], []),
              trail := [] }] } : SchedulerConfig leaf)

/-- The reachability invariant the F1-witness exclusion needs (owner
S2/S3): every saved checkpoint of a reachable configuration identifies the
current branch at its own level. Necessary for any `Identifies`-based
`perform` consumer, but — per the R1 finding above — NOT sufficient to
exclude the F1 witness, which satisfies this field. -/
def ReachableCheckpointsIdentify (leaf : Assignment → Bool) : Prop :=
  ∀ cfg : SchedulerConfig leaf, SchedulerReachable cfg →
    ∀ cp ∈ cfg.checkpoints, cp.Identifies cfg.branch cp.level

/-! ## §6 The P5 consumer interface (progress on reachable execution only) -/

/-- The named P5 consumer interface: progress is stated ONLY on reachable
execution, over the phase dispatcher and the C3a rank. R1 fixes the shape;
P5 owns the proof (and must not weaken it back to an unrestricted
`∀ cfg` statement — F1 refutes those; see PLAN.md P5). -/
def ReachablePhaseProgress (leaf : Assignment → Bool) : Prop :=
  ∀ (cfg cfg' : SchedulerConfig leaf),
    SchedulerReachable cfg → (C3b.phaseNext cfg).successor = some cfg' →
      RankLt (SchedulerRank cfg') (SchedulerRank cfg)

end LeanFzn.Solver.UIP
